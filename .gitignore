# ── 게임 설치본 ───────────────────────────────────────────
# 저작권 물건이다. 절대 커밋하지 않는다.
client/
*.exe
*.mus
*.wav

# 녹스 데이터 파일. 설치 후 실제 확장자를 확인해서 채운다.
*.map
*.bag
*.bin
*.rle
*.mp3

# ── 역분석 산물 ───────────────────────────────────────────
# 패킷 캡처는 남에게 주지 않는다 (저작권법 101조의4).
dumps/
*.pcap
*.pcapng
*.dump

# ── 참고용으로 받아둔 남의 저장소 ─────────────────────────
# 내 코드와 섞이면 나중에 가릴 수 없다.
third_party/
vendor/

# ── 빌드 ──────────────────────────────────────────────────
build/
out/
bin/
*.obj
*.pdb
*.ilk
*.dll
*.lib
*.exp

# ── IDE ───────────────────────────────────────────────────
.vs/
.vscode/
CMakeSettings.json
*.user
