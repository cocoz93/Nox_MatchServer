# ── 게임 설치본 ───────────────────────────────────────────
# 저작권 물건이다. 절대 커밋하지 않는다.
client/
*.exe
*.mus
*.wav

# 녹스 데이터 파일. 설치 후 실제 확장자를 확인해서 채운다.
*.map
*.bag
*.bin
*.rle
*.mp3

# 로컬 산출물
_out/

# 이 PC 전용 실행 도구 — 공개 리포에 올리지 않는다(2026-10-29 지난 이력에서도 뺌)
tools/pack_client.ps1
client_mod/mo_client/

# 녹스 데이터 파일 복호 키 표(opennox/noxcrypt 에서 뽑음) — 게임 열쇠라 공개 리포에 올리지 않는다(2026-10-29 지난 이력에서도 뺌)
server/include/nox/BlowfishTables.h

# MO 설정(`tools/mo_host.ps1` 이 만든다) — 입장 토큰 서명 키는 비밀이다(Docs/TOKEN_DESIGN.md)
config/

# ── 역분석 산물 ───────────────────────────────────────────
# 패킷 캡처는 남에게 주지 않는다 (저작권법 101조의4).
dumps/
_evidence/
*.pcap
*.pcapng
*.dump

# ── 참고용으로 받아둔 남의 저장소 ─────────────────────────
# 내 코드와 섞이면 나중에 가릴 수 없다.
third_party/
vendor/

# ── 빌드 ──────────────────────────────────────────────────
build/
out/
bin/
*.obj
*.pdb
*.ilk
*.dll
*.lib
*.exp

# ── IDE ───────────────────────────────────────────────────
.vs/
.vscode/
CMakeSettings.json
*.user

# ── 게임 화면 캡처 ────────────────────────────────────────
# 게임 그래픽은 저작물이다. 증거용 캡처는 리포 밖에 둔다.
*.png
*.jpg
*.bmp

# 파이썬이 만드는 바이트코드 캐시 — 2026-09-07 에 실수로 커밋됐다가 뺐다
__pycache__/
*.pyc

# 로컬 작업 메모 파일 — 공개 리포에 올리지 않는다
# (지금까지는 전역 무시 목록에만 기대고 있어서 다른 PC에서 클론하면 안 막혔다)
CLAUDE.md
**/CLAUDE.md
AGENTS.md
.claude/

# 설계 문서 — 작업 메모라 공개 리포에 올리지 않는다(2026-10-28 지난 이력에서도 뺌)
Docs/

# opennox(GPL-3.0) 소스에 대한 로컬 수정 기록 — GPL 원문이 들어 있어 공개 리포에 올리지 않는다(2026-10-28 지난 이력에서도 뺌)
tools/opennox-local/
